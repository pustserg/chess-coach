# Copy to .env and fill in real values for local development.
# Docker Compose reads this file to fill in docker-compose.yml's ${VAR} references.

# Postgres password for the local db/api containers (docker-compose.yml).
POSTGRES_PASSWORD=chess

# Secret used to sign JWTs (docker-compose.yml, services/api). Required — no default.
JWT_SECRET=change-me

# Optional: override the Ollama model the AI coach uses (default qwen2.5:7b-instruct).
# Useful if your network can't pull large (~4.7GB) models — see docker-compose.yml.
# OLLAMA_MODEL=qwen2.5:3b
